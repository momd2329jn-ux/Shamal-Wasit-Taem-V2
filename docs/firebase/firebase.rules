rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // المستخدمون
    // ==========================================
    match /users/{userId} {
      // المستخدم يقرأ بياناته
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // المدير يقرأ كل المستخدمين
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // المستخدم ينشئ حسابه
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // المستخدم يعدّل بياناته (ما عدا الدور والصلاحيات)
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']);
      
      // المدير يعدّل أي حساب
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // الاستفسارات
    // ==========================================
    match /inquiries/{inquiryId} {
      // المستخدم المسجّل أو المجهول يقرأ استفساراته
      allow read: if request.auth != null;
      
      // أي مستخدم مسجّل (أو مجهول) ينشئ استفسار
      allow create: if request.auth != null;
      
      // المدير والمشرف المختص يعدّلون
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        'inquiries' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions
      );
      
      // المدير يحذف
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // الأقسام (الأخبار، الفعاليات، المقالات، الصحة، البيئة)
    // ==========================================
    match /{collection}/{docId} {
      where collection in ['news', 'events', 'articles', 'health', 'environment'] {
        
        // الجميع يقرأ
        allow read: if true;
        
        // المدير والمشرف المختص ينشئون ويعدّلون ويحذفون
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          collection in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions
        );
      }
    }

    // ==========================================
    // أيقونات الفريق
    // ==========================================
    match /siteIcons/{iconId} {
      // الجميع يقرأ
      allow read: if true;
      
      // المدير فقط يعدّل
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

  }
}
